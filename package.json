{
  "name": "dcss-deck",
  "productName": "DCSS Deck",
  "version": "0.1.0",
  "description": "Controller-first webtiles client for Dungeon Crawl Stone Soup, built for the Steam Deck",
  "license": "GPL-2.0-or-later",
  "main": "dist/main/main.js",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "npm run build && electron .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dist": "npm run build && electron-builder --linux AppImage"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
